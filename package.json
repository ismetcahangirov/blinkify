{
  "name": "blinkify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Windows desktop video editor that edits video without degrading it",
  "license": "MIT",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @blinkify/desktop dev",
    "tauri": "pnpm --filter @blinkify/desktop exec tauri",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm run test:ts && pnpm run test:rust",
    "test:ts": "vitest run",
    "test:rust": "cargo test --workspace",
    "types:generate": "cargo test --workspace export_bindings && node tools/generate-types-index.mjs",
    "lint:rust": "cargo clippy --workspace --all-targets -- -D warnings",
    "format:rust:check": "cargo fmt --all --check",
    "check:links": "node tools/check-links.mjs",
    "labels:check": "node tools/apply-labels.mjs --check",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run format:rust:check && pnpm run lint:rust && pnpm run test && pnpm run build && pnpm run check:links"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.8",
    "turbo": "^2.11.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
