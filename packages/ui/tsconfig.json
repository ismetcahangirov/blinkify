{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    /* `node` is here for the token tests, which read `tokens.css` and the
       contrast table off disk. `vite/client` is for `import.meta.glob`, which
       is how the story accessibility suite discovers every story rather than
       keeping a second list of them. The jest-dom entry supplies the matcher
       types the component tests assert with. The design system itself ships no
       Node code — a component reaching for `fs` is a review failure, not a type
       error. */
    "types": ["node", "vite/client", "@testing-library/jest-dom/vitest"],
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "declaration": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
